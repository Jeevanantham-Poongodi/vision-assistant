# Copy to backend/.env and fill in. NEVER commit the real .env.

# --- Coder 3: backend ---
PIPELINE=stub
ALLOWED_ORIGINS=http://localhost:5173
# Phone demo through Cloudflare quick tunnels (docs/07_HTTPS_DEMO.md): accepts every new tunnel URL.
# Demo only - it lets any trycloudflare.com page call the API. Leave empty otherwise.
# ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.trycloudflare\.com$
ALLOWED_ORIGIN_REGEX=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FEATURE_GUARDIAN=false
FEATURE_ALERTS_DB=false
DEBUG_SAVE_FRAMES=0

# --- Coder 2: vision ---
YOLO_MODEL=yolov8n.pt
CAMERA_FOCAL_PX=

# --- Coder 4: integrations ---
GEMINI_API_KEY=
GEMINI_MODEL=
TESSERACT_CMD=/usr/bin/tesseract
MAPBOX_TOKEN=
FEATURE_ASK=false
FEATURE_OCR=false
FEATURE_NAVIGATION=false
